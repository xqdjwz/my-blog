{
  "name": "innovate-blog-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute innovate-blog --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute innovate-blog --local --file=schema.sql",
    "db:import:local": "wrangler d1 execute innovate-blog --local --file=paid-articles.sql",
    "db:import": "wrangler d1 execute innovate-blog --remote --file=paid-articles.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.168.0"
  }
}