---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getAllPosts, getCategories } from '../lib/posts';

const posts = await getAllPosts();
const featured = posts.filter((post) => post.data.featured).slice(0, 2);
const latest = posts.slice(0, 8);
const categories = getCategories(posts);
---

<BaseLayout description="创新博客：记录技术、产品与创作的长文，支持分类、全文搜索与付费阅读。">
  <div class="container">
    <section class="hero">
      <h1>把想法写下来，<br />把经验留下来。</h1>
      <p>
        这里是我的长期写作空间：技术笔记、产品思考与创作复盘。
        文章按分类归档，支持关键词搜索，部分深度长文需要兑换码解锁。
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/posts/">浏览全部文章</a>
        <a class="btn" href="/search/">搜索关键词</a>
      </div>
    </section>

    {featured.length > 0 && (
      <section>
        <div class="section-head">
          <h2>精选</h2>
        </div>
        <div class="post-list">
          {featured.map((post) => <PostCard post={post} />)}
        </div>
      </section>
    )}

    <section>
      <div class="section-head">
        <h2>最新文章</h2>
        <a href="/posts/">查看全部 {posts.length} 篇 →</a>
      </div>
      {latest.length === 0 ? (
        <p class="empty">还没有文章，去 src/content/posts 里写第一篇吧。</p>
      ) : (
        <div class="post-list">
          {latest.map((post) => <PostCard post={post} />)}
        </div>
      )}
    </section>

    <section>
      <div class="section-head">
        <h2>按分类浏览</h2>
        <a href="/categories/">全部分类 →</a>
      </div>
      <div class="category-grid">
        {categories.map((category) => (
          <a class="category-card" href={`/categories/${category.slug}/`}>
            <strong>{category.name}</strong>
            <span>{category.count} 篇文章</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
